profile default {
    output eDP-1 enable scale 1
    exec /bin/bash ~/.config/kanshi/notify_layout.sh
}

profile default_125 {
    output eDP-1 enable scale 1.25
    exec /bin/bash ~/.config/kanshi/notify_layout.sh
}

profile DOUBLE_HORIZONTAL_RIGHT {
    output eDP-1 enable position 1920,0 scale 1.25
    output "Hewlett Packard *" {
        enable
        position 0,0
        scale 1
    }
    exec /bin/bash ~/.config/kanshi/notify_layout.sh
}

profile DOUBLE_HORIZONTAL_LEFT {
    output eDP-1 enable position 0,0 scale 1.25
    output "Hewlett Packard *" {
        enable
        position 1536,0
        scale 1
    }
    exec /bin/bash ~/.config/kanshi/notify_layout.sh
}

profile DOUBLE_VERTICAL {
    output eDP-1 enable position 0,1080 scale 1.25
    output "Hewlett Packard *" {
        enable
        position 0,0
        scale 1
    }
    exec /bin/bash ~/.config/kanshi/notify_layout.sh
}

profile TRIPLE {
    output eDP-1 enable position 1920,0 scale 1.25
    output "Hewlett Packard *" {
        enable
        position 0,0
        scale 1
    }
    output "GWD *" {
        enable
        position 0,1080
        scale 1.25
    }
    exec /bin/bash ~/.config/kanshi/notify_layout.sh
}

profile TRIPLE_LID_CLOSE {
    output eDP-1 disable
    output "Hewlett Packard *" {
        enable
        position 0,0
        scale 1
    }
    output "GWD *" {
        enable
        position 1920,0
        scale 1.25
        transform 90
    }
    exec /bin/bash ~/.config/kanshi/notify_layout.sh
}

